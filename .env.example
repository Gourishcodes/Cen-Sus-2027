# Copy this file to .env.local (gitignored) and fill in the real value.
# This key is read SERVER-SIDE ONLY (functions/gemini-proxy.ts) via a
# Cloud Function / server environment variable. It is never prefixed with
# VITE_ and never imported into any file under /src, so it can never end up
# in the client bundle.
GEMINI_API_KEY=YOUR_API_KEY_HERE
